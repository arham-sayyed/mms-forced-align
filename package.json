{
  "name": "mms-forced-align",
  "version": "0.2.1",
  "description": "Forced alignment for JavaScript, TypeScript and Node.js: word-level timestamps from audio + transcript for captions, subtitles and karaoke. Meta MMS (wav2vec2) via ONNX Runtime with a CTC Viterbi decoder. Hindi, Hinglish and 20 Indic languages. No Python.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/model.inference.test.ts --exclude test/align.golden.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "forced-alignment",
    "ctc",
    "wav2vec2",
    "mms",
    "captions",
    "subtitles",
    "karaoke",
    "word-timestamps",
    "indic-languages",
    "romanization",
    "hindi",
    "devanagari",
    "typescript",
    "nodejs",
    "javascript",
    "onnx",
    "onnxruntime",
    "speech-alignment",
    "audio-alignment",
    "word-level-timestamps",
    "torchaudio",
    "meta-mms",
    "subtitle-sync",
    "hinglish"
  ],
  "license": "MIT",
  "author": {
    "name": "Arham Sayyed",
    "url": "https://github.com/arham-sayyed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arham-sayyed/mms-forced-align.git"
  },
  "bugs": {
    "url": "https://github.com/arham-sayyed/mms-forced-align/issues"
  },
  "homepage": "https://github.com/arham-sayyed/mms-forced-align#readme",
  "dependencies": {
    "onnxruntime-node": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "node-wav": "^0.0.2",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
